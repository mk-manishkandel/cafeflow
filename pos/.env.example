# CafeFlow POS — environment configuration
# Copy to pos/.env and fill in real values. One file serves both the Express
# server (read via dotenv) and the Vite build (VITE_* variables).
# Never commit pos/.env.
#
# Generate secrets with:  openssl rand -base64 48 | tr -d '/+'

# ── Server ────────────────────────────────────────────────────────────────────
# Port the API listens on. Nginx and scripts/update.sh expect 3001
# (the server falls back to 5000 if unset).
PORT=3001
NODE_ENV=production
# winston log level: error | warn | info | debug
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Required. Comma-separated origins allowed to call the API (no trailing slash,
# no "*" in production). Include the student ordering app's origin if used.
CORS_ORIGIN=https://pos.example.com,https://order.example.com
# Optional. Public URL of the POS; adds wss://<host> to the CSP connect-src.
FRONTEND_URL=https://pos.example.com

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cafeflow
DB_USER=cafeflow_user
# Required
DB_PASSWORD=change_me
# Optional. Total pool size shared across all PM2 cluster workers (default 100).
DB_POOL_MAX=100

# ── Security secrets ──────────────────────────────────────────────────────────
# Required. Each at least 32 characters; JWT_SECRET and REFRESH_TOKEN_SECRET must differ.
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
REFRESH_TOKEN_SECRET=change_me_to_a_different_long_random_string
# Required. Key for field-level encryption of stored secrets (e.g. SMTP password).
# Keep it stable — changing it makes previously encrypted values unreadable.
DB_ENCRYPTION_SECRET=change_me_to_a_stable_random_string_min_32_chars
# Recommended. Independent salt for the encryption key (openssl rand -hex 16).
# Must differ from DB_ENCRYPTION_SECRET. Keep it stable once set.
DB_ENCRYPTION_SALT=change_me_32_hex_chars

# Optional token lifetimes (defaults: 15m / 7d)
# JWT_EXPIRES_IN=15m
# REFRESH_TOKEN_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────────────────────────────
# Include the password in production: redis://:PASSWORD@127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# ── Timezone ──────────────────────────────────────────────────────────────────
# Required. Both must be the same IANA zone. TZ drives the server, SQL and cron;
# VITE_APP_TIMEZONE is baked into the frontend at build time (rebuild after changing).
TZ=Asia/Kathmandu
VITE_APP_TIMEZONE=Asia/Kathmandu

# ── Student ordering app (optional) ───────────────────────────────────────────
# Only requests whose Origin header matches this value may use
# /api/public/student-menu and /api/public/student-orders. If unset, those
# endpoints return 403.
STUDENT_ORDER_ALLOWED_ORIGIN=https://order.example.com
# Optional shared secret. When set, student ordering requests must also send it in
# the x-cafeflow-client header. Leave empty unless your client sends that header.
STUDENT_CLIENT_SECRET=

# ── Email / SMTP fallback (optional) ──────────────────────────────────────────
# SMTP is normally configured in Business Setup → Email Settings (stored in the DB).
# These values are used only when no SMTP settings are saved there.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Recipients for system report / admin notification emails
SYSTEM_NOTIFICATION_EMAIL=
SYSTEM_ADMIN_EMAIL=
# Development only: redirect every bulk statement email to this address
# EMAIL_TEST_RECIPIENT=

# ── AI menu assistant (optional) ──────────────────────────────────────────────
# Google Gemini API key for menu category suggestions. AI features are disabled if unset.
GEMINI_API_KEY=

# ── Background jobs (optional) ────────────────────────────────────────────────
# Minutes before a pending network print job is considered stale and retried (default 5)
# PRINT_SWEEP_MINUTES=5

# ── Vite dev server (development only) ────────────────────────────────────────
# Extra hostnames allowed by `npm run dev` (comma-separated)
VITE_ALLOWED_HOSTS=localhost
# Backend URL the dev server proxies /api and /uploads to (default http://127.0.0.1:3001)
VITE_API_URL=http://127.0.0.1:3001
