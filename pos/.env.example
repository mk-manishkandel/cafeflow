# CafeFlow POS — environment configuration
# Copy to pos/.env and fill in real values. One file serves both the Express
# server (read via dotenv) and the Vite build (VITE_* variables).
# Never commit pos/.env.
#
# Generate secrets with:  openssl rand -base64 48 | tr -d '/+'
#
# After changing this file on a running server, restart PM2 with a clean
# environment. `pm2 reload` alone can keep the old values, because PM2 stores
# the environment it was started with and dotenv never overrides it:
#   pm2 delete cafeflow-pos && env -i PATH="$PATH" HOME="$HOME" pm2 start ecosystem.config.cjs && pm2 save

# ── Server ────────────────────────────────────────────────────────────────────
# Nginx and scripts/update.sh expect 3001
PORT=3001
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API (no trailing slash, no "*").
# Must be https:// — in production the login cookies are Secure, so over plain
# http the browser drops them and nobody can log in.
CORS_ORIGIN=https://pos.example.com,https://order.example.com

# ── Student Ordering ──────────────────────────────────────────────────────────
# Only requests from this origin can call /api/public/student-menu & /api/public/student-orders
# Must also be included in CORS_ORIGIN above. Empty = those endpoints return 403.
STUDENT_ORDER_ALLOWED_ORIGIN=https://order.example.com
# Shared secret — the ordering app must send this as the x-cafeflow-client header.
# Empty = header not required.
STUDENT_CLIENT_SECRET=change_me

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=cafeflow_user
DB_HOST=localhost
DB_NAME=cafeflow
DB_PASSWORD=change_me
DB_PORT=5432
# Total connections shared across all PM2 workers. Keep it below PostgreSQL
# max_connections (default 100) so backups and psql can still connect.
DB_POOL_MAX=80

# ── Security Secrets ──────────────────────────────────────────────────────────
# Each at least 32 characters; JWT_SECRET and REFRESH_TOKEN_SECRET must differ.
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
REFRESH_TOKEN_SECRET=change_me_to_a_different_long_random_string
# Encrypts stored secrets (e.g. the SMTP password). Never change these on an
# existing install — previously encrypted values become unreadable.
DB_ENCRYPTION_SECRET=change_me_to_a_stable_random_string_min_32_chars
# openssl rand -hex 16
DB_ENCRYPTION_SALT=change_me_32_hex_chars

# ── Redis Cache ───────────────────────────────────────────────────────────────
REDIS_URL=redis://:change_me@127.0.0.1:6379

# ── AI Service (Optional) ────────────────────────────────────────────────────
# Google Gemini key for menu category suggestions. Empty = AI features off.
GEMINI_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info

# ── Application URL ───────────────────────────────────────────────────────────
# Hostnames allowed by the Vite dev server (comma-separated)
VITE_ALLOWED_HOSTS=pos.example.com

# ── Timezone ──────────────────────────────────────────────────────────────────
# Both must be the same IANA zone. VITE_APP_TIMEZONE is baked into the frontend
# at build time (rebuild after changing).
TZ=Asia/Kathmandu
VITE_APP_TIMEZONE=Asia/Kathmandu
