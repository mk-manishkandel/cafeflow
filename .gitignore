# CafeFlow — repository .gitignore

# ── Dependencies ──────────────────────────────────────────────────────────────
**/node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
# pos/dist is served live by nginx; it is built on the server, never committed.
**/dist/
**/dist-ssr/
*.tsbuildinfo
# Generated by pos/generate-version.js on every build
pos/public/version.json

# ── Environment files (keep the templates) ────────────────────────────────────
**/.env
**/.env.*
!**/.env.example

# ── Runtime data ──────────────────────────────────────────────────────────────
# Logs (pos/server/logs, PM2, npm)
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
.pm2/
# User uploads (pos/server/public/uploads, pos/server/uploads/tmp, pos/uploads)
**/uploads/
**/_temp/
**/tmp/
# Database dumps and backups
backups/
*.sql.gz
*.dump
*.bak

# ── Tests / coverage output ───────────────────────────────────────────────────
**/coverage/
**/.nyc_output/
**/playwright-report/
**/test-results/

# ── Editors, OS, local tooling ────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
# Claude Code local settings and agent worktrees
.claude/
